# --- The Deep Dive: copy to .env and fill in (don't commit .env) ---

# Anthropic Claude API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Resend API key. Sign up at https://resend.com/ -> API Keys.
RESEND_API_KEY=re_...

# Where the newsletter is sent (your inbox).
NEWSLETTER_TO=you@example.com

# Verified sender. Must be on a domain you've verified in Resend.
# (For first tests you can use Resend's onboarding@resend.dev sandbox sender.)
NEWSLETTER_FROM=The Deep Dive <deepdive@yourdomain.com>

# --- Optional (sensible defaults shown) ---

# Curation model.
ANTHROPIC_MODEL=claude-opus-4-8

# Where topic history is stored. On Railway, attach a Volume and set this to /data.
DATA_DIR=./data

# Number of deep dives per issue.
DEEP_DIVE_COUNT=3

# Masthead title.
NEWSLETTER_TITLE=The Deep Dive
