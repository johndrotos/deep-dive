# --- The Deep Dive: copy to .env and fill in (don't commit .env) ---

# Anthropic Claude API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Resend API key. Sign up at https://resend.com/ -> API Keys.
RESEND_API_KEY=re_...

# Where the newsletter is sent (your inbox).
NEWSLETTER_TO=you@example.com

# Verified sender. Must be on a domain you've verified in Resend.
# (For first tests you can use Resend's onboarding@resend.dev sandbox sender.)
NEWSLETTER_FROM=The Deep Dive <deepdive@yourdomain.com>

# --- Optional (sensible defaults shown) ---

# Curation model.
ANTHROPIC_MODEL=claude-opus-4-8

# Where topic history is stored. On Railway, attach a Volume and set this to /data.
DATA_DIR=./data

# Number of deep dives per issue (what actually ships).
DEEP_DIVE_COUNT=3

# Candidate topics researched before an Opus judge keeps the best DEEP_DIVE_COUNT.
# Over-provisioning lets thin topics be dropped after we see their real content.
TOPIC_CANDIDATES=5

# Masthead title.
NEWSLETTER_TITLE=The Deep Dive

# --- Search depth (speed vs. thoroughness) ---
# Lower = faster & cheaper; raise for deeper digs. Defaults shown are a balanced setting.
# Worst case per topic = (SEARCH_MAX_ROUNDS + 1) turns, each <= SEARCH_MAX_USES searches.
SEARCH_EFFORT=medium       # low | medium | high
SEARCH_MAX_TOKENS=8000     # length cap on each research brief (>=1000)
SEARCH_MAX_USES=5          # web searches per turn
SEARCH_MAX_ROUNDS=0        # extra continuation rounds (0 = single quick turn)
# Web-search tool variant:
#   false = basic tool — results go straight to Claude (fast, predictable). Recommended.
#   true  = newer dynamic-filtering tool — filters results with server-side code first;
#           more thorough but can stall in an unbounded filtering loop on some models.
SEARCH_DYNAMIC_FILTERING=false
# Over-provision + select: research SEARCH_CANDIDATE_ITEMS per topic, verify their links,
# then keep the best DEEP_DIVE_ITEMS. Over-provisioning survives dead-link drops.
SEARCH_CANDIDATE_ITEMS=6   # candidates researched per topic
DEEP_DIVE_ITEMS=4          # items that make the final page
